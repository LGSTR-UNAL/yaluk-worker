# --- Kafka (required) ---
KAFKA_HOST=localhost:9093
CONSUMER_GROUP_ID=yaluk-worker
REQUEST_TOPIC=yaluk-requests
RESULTS_TOPIC=yaluk-results

# --- Kafka (optional) ---
# KAFKA_AUTO_OFFSET_RESET=earliest
# MAX_POLL_INTERVAL_MS=3600000
# PRODUCER_FLUSH_TIMEOUT=60

# --- S3 / MinIO ---
# Leave the credentials empty to use the default AWS credential chain.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REQUESTS_BUCKET=yaluk-requests
# S3_RESOURCES_BUCKET=yaluk-resources
# S3_RESULTS_BUCKET=yaluk-results
# S3_SURGE_ARRESTERS_PREFIX=surge-arresters

# --- PostgreSQL (required) ---
POSTGRES_HOST=localhost
POSTGRES_DB=yaluk
POSTGRES_USER=yaluk
POSTGRES_PASSWORD=

# --- PostgreSQL (optional) ---
# POSTGRES_PORT=5432
# POSTGRES_POOL_MAX_SIZE=2
# POSTGRES_POOL_TIMEOUT=30
# SIMULATION_TABLE=streaming.simulation

# --- ATP / YALUK (required) ---
TPBIG_PATH=/opt/yaluk/libatp/tpbig
YALUK_PATH=/opt/yaluk/libatp

# --- Worker (optional) ---
# WORK_DIR=/tmp
# LOG_LEVEL=INFO
